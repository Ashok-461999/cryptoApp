# ScalpTrack Pro — Backend Environment (local + EC2)

# Neon Postgres (optional) — without this, SQLite is used at ./data/cryptoapp.db
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

CRYPTO_CAPITAL_INR=20000
RISK_PER_TRADE_INR=200
TAKE_PROFIT_INR=150
MIN_RR_FOR_TAKE=1.0
SCAN_INTERVAL_SECONDS=60
SCALP_HOLDING_MINUTES=2
MAX_TAKE_SIGNALS_PER_DAY=150
USDT_TO_INR=83
CORS_ORIGINS=*
APP_ENV=production

# --- Delta Exchange India (options/GEX + whale flow) ---
# Create at delta.exchange → API Keys. NEVER commit real keys to git.
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_EXCHANGE_BASE_URL=https://api.india.delta.exchange

# --- Binance Futures AUTO-EXECUTE (real trades) ---
# Create API key at Binance → API Management → Enable Futures
# Restrict IP to your server (e.g. EC2 13.201.83.70) — NEVER commit real keys to git
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_TESTNET=false
AUTO_EXECUTE_TRADES=false
AUTO_EXECUTE_MIN_CONFIDENCE=55
MAX_EXCHANGE_TRADES_PER_DAY=150
MAX_EXCHANGE_OPEN_POSITIONS=1
LEVERAGE_MIN=25
LEVERAGE_MAX=35
LEVERAGE_HQ_MIN=30
LEVERAGE_HQ_MAX=40
TAKE_PROFIT_USDT=0.25
TAKE_PROFIT_USDT_MIN=0.22
TAKE_PROFIT_USDT_MAX=0.30
RISK_PER_TRADE_USDT=0.22
RISK_PER_TRADE_USDT_MAX=0.25
